# ---------------------------------------------------------------------------
# Server-side only. NOTHING here gets a VITE_ prefix — Vite inlines VITE_* vars
# into the client bundle, which is how the original prototype leaked its key.
# Locally these load via `vercel dev` from .env.local; in production set them
# in the Vercel project's Environment Variables.
# ---------------------------------------------------------------------------

# OpenAI — powers the concierge answers, web enrichment, and call extraction
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Supabase — the property store (free tier)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vapi — outbound voice agent that calls the property contact
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# Set to 1 to stub web enrichment with deterministic fake data (no cost, no network)
MOCK_ENRICH=0
