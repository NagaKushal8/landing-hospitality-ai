# ---------------------------------------------------------------------------
# Server-side only. NOTHING here gets a VITE_ prefix — Vite inlines VITE_* vars
# into the client bundle, which is how the original prototype leaked its key.
# Locally these load via `vercel dev` from .env.local; in production set them
# in the Vercel project's Environment Variables.
# ---------------------------------------------------------------------------

# OpenAI — powers the concierge answers, web enrichment, and call extraction
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Supabase — the property store (free tier). See "Setting up Supabase" in the
# README. Settings -> API Keys.
#
# Take the SECRET key (`sb_secret_...`), not the publishable one. RLS is on with
# no policies, so a publishable key reads nothing and every request comes back
# empty rather than failing somewhere that points at the cause.
#
# Projects created after Nov 2025 only have `sb_secret_...`. Older projects also
# have a legacy `service_role` JWT (`eyJ...`) — that still works, either set it
# here or keep using SUPABASE_SERVICE_ROLE_KEY, which is still read as a fallback.
#
# This key bypasses row-level security. Server-side only, never VITE_ prefixed.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# Vapi — the outbound voice agent. See "Setting up Vapi" in the README.
# ---------------------------------------------------------------------------

# Dashboard -> API Keys -> PRIVATE key. The public key only works for web calls;
# POST /call is privately scoped and will 401 with the public one.
VAPI_API_KEY=

# Dashboard -> Phone Numbers -> Create Phone Number -> Free Vapi Number.
# This is the number's UUID, not the phone number itself.
VAPI_PHONE_NUMBER_ID=

# --- Optional Vapi tuning (all have working defaults) ---

# Model the agent thinks with during the call. gpt-4o holds a conversation
# noticeably better than mini here, and the token cost of a 5-minute call is
# trivial next to the per-minute telephony charge.
# VAPI_MODEL=gpt-4o

# Hard cap on call length, in seconds. Calls are billed per minute, so this is
# the backstop against one that goes sideways. Default 480 (8 min); we promise
# the contact five.
# VAPI_MAX_SECONDS=480

# Voice. Omit both and Vapi uses its default. Set both together — one alone is
# ignored. Voice IDs are listed in the dashboard under Voice Library.
# VAPI_VOICE_PROVIDER=vapi
# VAPI_VOICE_ID=

# ---------------------------------------------------------------------------

# Set to 1 to stub web enrichment with deterministic fake data (no cost, no
# network). Useful for building the UI without spending anything.
MOCK_ENRICH=0
