# ---------------------------------------------------------------------------
# Server-side only. NOTHING here gets a VITE_ prefix — Vite inlines VITE_* vars
# into the client bundle, which is how the original prototype leaked its key.
# Locally these load via `vercel dev` from .env.local; in production set them
# in the Vercel project's Environment Variables.
# ---------------------------------------------------------------------------

# OpenAI — powers the concierge answers, web enrichment, and call extraction
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Supabase — the property store (free tier). See "Setting up Supabase" in the
# README. Settings -> API Keys.
#
# Take the SECRET key (`sb_secret_...`), not the publishable one. RLS is on with
# no policies, so a publishable key reads nothing and every request comes back
# empty rather than failing somewhere that points at the cause.
#
# Projects created after Nov 2025 only have `sb_secret_...`. Older projects also
# have a legacy `service_role` JWT (`eyJ...`) — that still works, either set it
# here or keep using SUPABASE_SERVICE_ROLE_KEY, which is still read as a fallback.
#
# This key bypasses row-level security. Server-side only, never VITE_ prefixed.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# Bland — the outbound voice agent. See "Setting up Bland" in the README.
# ---------------------------------------------------------------------------

# Dashboard -> API Keys. Sent bare in the Authorization header; the adapter
# retries once with a Bearer prefix if that is rejected.
BLAND_API_KEY=

# Voice id from Bland's Voice Library. Leave empty for their default.
BLAND_VOICE=

# 'base' (default, more careful) or 'turbo' (faster, less considered)
# BLAND_MODEL=base

# Hard cap on call length in minutes. Bland bills per minute plus a flat fee
# per attempt, so this is the backstop against a call that goes sideways
# unattended. We promise the contact five.
CALL_MAX_MINUTES=8

# Roughly 50-200; lower interrupts more eagerly. Property managers trail off
# mid-sentence ("uh, under uh...") and cutting them off there loses the answer,
# so this leans patient.
# BLAND_INTERRUPTION_THRESHOLD=150

# Set to 1 to stub web enrichment with deterministic fake data (no cost, no
# network). Useful for building the UI without spending anything.
MOCK_ENRICH=0

# ---------------------------------------------------------------------------
# Demo limits. This app is meant to be deployed and the link emailed, so it is
# opened unattended and may be forwarded. These bound what that can cost.
# ---------------------------------------------------------------------------

# Hard total spend ceiling in USD across ALL calls, enrichments and answers.
# Nothing bypasses this, including the PIN — so the worst case is knowable
# before you send the link. Past it, calls replay a recording instead.
DEMO_BUDGET_USD=5

# Calls per day before the PIN is required. Note this interacts with the
# ceiling above: 5 calls/day at ~$0.60 each spends $5 in under two days.
DEMO_DAILY_CALL_LIMIT=5

# Unlocks calls past the daily limit. Leave EMPTY to disable extra calls
# entirely once the daily count is reached. Send it in the email only if the
# recipient may need more than the daily allowance.
DEMO_PIN=

# What one call is assumed to cost before Vapi reports the real figure. Held
# against the ceiling, then reconciled once the call ends.
DEMO_CALL_ESTIMATE_USD=0.75

# Pins ONE call as the recording shown when a live call cannot be placed. Set
# this to the id of your best call once you have made one. Without it the app
# picks the call that captured the most fields, which is usually right — but a
# visitor who answers and hangs up early still produces a real transcript, and
# pinning removes any chance of that becoming what the next person sees.
DEMO_REPLAY_CALL_ID=
