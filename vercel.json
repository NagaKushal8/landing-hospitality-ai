{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/onboard/*.js": {
      "maxDuration": 60,
      "includeFiles": "src/data/**"
    },
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "src/data/**"
    },
    "api/homes/*.js": {
      "maxDuration": 30,
      "includeFiles": "src/data/**"
    }
  },
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
